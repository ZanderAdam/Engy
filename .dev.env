# Dev-only environment variables (gitignored)
# Copy from .env.example and customize as needed

# Web server
# Leave PORT unset: scripts/dev.mjs always picks a free port and sets
# ENGY_SERVER_URL to match. Read the actual port from the `[dev]` startup log
# line — don't hardcode PORT or ENGY_SERVER_URL here.
ENGY_DIR=.dev-engy/
