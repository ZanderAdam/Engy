# Dev-only environment variables (gitignored)
# Copy from .env.example and customize as needed

# Web server
# PORT is the *preferred* dev port. If it's busy, scripts/dev.mjs picks a free
# port and sets ENGY_SERVER_URL to match — so don't hardcode ENGY_SERVER_URL here.
PORT=4000
ENGY_DIR=.dev-engy/
